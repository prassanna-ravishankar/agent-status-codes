---
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description?: string; }
const { title, description = 'A shared status-code protocol for agents and applications.' } = Astro.props;
const pageTitle = title === 'Agent Status Codes' ? title : `${title} | Agent Status Codes`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImageUrl = new URL('/og-card.png', Astro.site ?? Astro.url);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Agent Status Codes" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Agent Status Codes, an open status-code protocol for agents and applications" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Agent Status Codes, an open status-code protocol for agents and applications" />
    <link rel="icon" href="/asc-mark.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <!--
    THESIS: ASC is a shared agent and application status vocabulary; this site refuses generic docs chrome and poster-sized protocol theatre.
    OWN-WORLD: cool-slate reference surfaces, IBM Plex, one nine-class strip, compact code-first controls.
    STORY: understand the problem, enter the numeric space, inspect the protocol, contribute an RFC.
    FIRST VIEWPORT: compact top navigation, concise hero, real ASC envelope, class navigation immediately below.
    FORM: engineered standards reference, pinned design system, seed 95000af6.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md.
    -->
    <Header />
    <slot />
    <Footer />
  </body>
</html>
