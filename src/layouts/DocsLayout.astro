---
import BaseLayout from './BaseLayout.astro';
import DocsNav from '../components/DocsNav.astro';
import ReferenceHeader from '../components/ReferenceHeader.astro';
import type { MarkdownHeading } from 'astro';
interface Props { title: string; headings?: MarkdownHeading[]; }
const title: string = Astro.props.title;
const headings: MarkdownHeading[] = Astro.props.headings ?? [];
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<BaseLayout title={title}>
  <div class="reference-shell shell">
    <ReferenceHeader />
    <div class="docs-shell">
      <DocsNav />
      <main class="prose" data-pagefind-body><slot /></main>
      <aside class="toc" aria-label="On this page">
        {toc.length > 0 && <><h2>On this page</h2><ol>{toc.map((heading) => <li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></>}
      </aside>
    </div>
  </div>
</BaseLayout>
