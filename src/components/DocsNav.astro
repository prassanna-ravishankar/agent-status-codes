---
import { sections } from '../data/navigation';
import NavIcon from './NavIcon.astro';
const current = Astro.url.pathname;
function iconFor(href: string) {
  if (href.includes('registry')) return 'registry';
  if (href.includes('envelope') || href.includes('examples')) return 'envelope';
  if (href.includes('retry')) return 'retry';
  if (href.includes('binding') || href.includes('implementation')) return 'binding';
  if (href.includes('security')) return 'security';
  if (href.startsWith('/rfcs') || href === '/contributing/') return 'document';
  if (href.startsWith('/spec')) return 'protocol';
  return 'start';
}
---
<aside class="docs-nav docs-nav-desktop" aria-label="Documentation navigation">
  {sections.map((section) => <section>
    <h2>{section.label}</h2>
    <ul>{section.links.map(([label, href]) => <li><a href={href} aria-current={current === href ? 'page' : undefined}>
      <NavIcon kind={iconFor(href)} /><span>{label}</span>
    </a></li>)}</ul>
  </section>)}
</aside>
<details class="docs-nav-mobile">
  <summary>Browse documentation</summary>
  <nav aria-label="Documentation navigation">
    {sections.map((section) => <section>
      <h2>{section.label}</h2>
      <ul>{section.links.map(([label, href]) => <li><a href={href} aria-current={current === href ? 'page' : undefined}>
        <NavIcon kind={iconFor(href)} /><span>{label}</span>
      </a></li>)}</ul>
    </section>)}
  </nav>
</details>
