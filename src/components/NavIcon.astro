---
interface Props { kind: 'start' | 'protocol' | 'registry' | 'envelope' | 'retry' | 'binding' | 'security' | 'document'; }
const { kind } = Astro.props;
---
<svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
  {kind === 'start' && <><circle cx="12" cy="12" r="8" /><path d="m10 8 6 4-6 4Z" /></>}
  {kind === 'protocol' && <><path d="M5 6h14M5 12h14M5 18h9" /><circle cx="3" cy="6" r=".75" /><circle cx="3" cy="12" r=".75" /><circle cx="3" cy="18" r=".75" /></>}
  {kind === 'registry' && <><path d="M4 5h5v5H4zM4 14h5v5H4zM12 6h8M12 9h6M12 15h8M12 18h6" /></>}
  {kind === 'envelope' && <><path d="M8 4H5v16h3M16 4h3v16h-3M10 8h4M10 12h4M10 16h4" /></>}
  {kind === 'retry' && <><path d="M18.5 8A7 7 0 0 0 6.7 5.7L4 8.5M5.5 16A7 7 0 0 0 17.3 18.3l2.7-2.8" /><path d="M4 4v4.5h4.5M20 20v-4.5h-4.5" /></>}
  {kind === 'binding' && <><circle cx="6" cy="12" r="3" /><circle cx="18" cy="12" r="3" /><path d="M9 12h6" /></>}
  {kind === 'security' && <><path d="M6 10h12v9H6zM8.5 10V7.5a3.5 3.5 0 0 1 7 0V10" /><circle cx="12" cy="14.5" r="1" /></>}
  {kind === 'document' && <><path d="M6 3h8l4 4v14H6zM14 3v5h4M9 12h6M9 16h6" /></>}
</svg>
